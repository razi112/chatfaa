# ─── Seed data ────────────────────────────────────────────────
# Set to "true" in development to unlock seed data generation.
# Must be "false" (or omitted) in production — never commit "true" here.
SEED_DATA_MODE="false"
VITE_SEED_DATA_MODE="false"
# ─── Local overrides (copy this to .env.local, never commit .env.local) ──────
# .env.local takes precedence over .env and is git-ignored.

# Unlock seed data generation in the Admin Panel and CLI script.
# Set this to "true" only in your local dev environment.
SEED_DATA_MODE="true"
VITE_SEED_DATA_MODE="true"

# Service-role key — required ONLY for the CLI seed script.
# Bypasses Row-Level Security for bulk inserts.
# Find it: Supabase Dashboard → Project Settings → API → service_role (secret)
# NEVER expose this key in client-side code or commit it to git.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ─── Usage (after copying this file to .env.local) ────────────────────────────
# npm run seed:generate   — insert @chatfaa_official + 2,000 seed users
# npm run seed:reset      — remove all seed data then regenerate
# npm run seed:remove     — remove all seed data
# npm run seed:stats      — print current seed row counts
